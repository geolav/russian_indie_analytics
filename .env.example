# ══════════════════════════════════════════════════════
#  Russian Indie Music Analytics — Environment Variables
#  Copy this file to .env and fill in your credentials.
# ══════════════════════════════════════════════════════

# ─── Spotify API ──────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ─── Yandex Music API (primary) ───────────────────────
# Get token via OAuth: https://oauth.yandex.ru/authorize?response_type=token&client_id=23cabbbdc6cd418abb4b39c32c41195d
YANDEX_MUSIC_TOKEN=your_yandex_token_here

# ─── Last.fm API ──────────────────────────────────────
# Get a free API key at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# ─── Genius API ───────────────────────────────────────
# Create a client at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=your_genius_access_token_here

# ─── App Settings ─────────────────────────────────────
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
